{
  "_comment": "v5: explicit absolute-window labels + a rich-text note stating the timezone/day semantics, so a near-midnight count of 0 is not mistaken for a fault.",
  "name": "Toronto Events",
  "grid": 48,
  "table": "u_toronto_event",
  "description": "Live view of Toronto events, with a map of where they concentrate.",
  "widgets": [
    {
      "kind": "filter",
      "label": "Category",
      "field": "u_primary_category",
      "filter_kind": "multiselect",
      "field_type": "string",
      "x": 0,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "filter",
      "label": "When",
      "field": "u_start",
      "filter_kind": "date",
      "x": 16,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "filter",
      "label": "Source",
      "field": "u_source",
      "filter_kind": "multiselect",
      "field_type": "string",
      "x": 32,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "heading",
      "label": "Toronto events at a glance",
      "level": "1",
      "x": 0,
      "y": 4,
      "w": 48,
      "h": 2
    },
    {
      "kind": "richtext",
      "label": "How these counts are defined",
      "html": "<p><b>How these counts are defined</b></p><ul><li><b>All day</b> = 00:00–23:59 of that calendar day, in your session timezone.</li><li><b>Still to come</b> = from this minute until 23:59 today. It falls to <b>0 as the day ends</b>, and just after midnight all three day cards reset — that is the new day, not an outage.</li><li><b>Rolling</b> = the next 7 / 30 days counted forward from now, not fixed dates.</li><li>These six cards deliberately <b>ignore the filters</b> at the top of the page, so they always show true absolute counts. The list and charts below <b>do</b> follow the filters.</li><li>An event whose venue has no coordinates cannot be plotted, so the map shows <b>fewer</b> events than the lists.</li></ul>",
      "x": 0,
      "y": 6,
      "w": 48,
      "h": 10
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Today",
      "label": "Today — all day",
      "follow_filters": false,
      "x": 0,
      "y": 16,
      "w": 8,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Still To Come Today",
      "label": "Today — still to come",
      "follow_filters": false,
      "x": 8,
      "y": 16,
      "w": 8,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Tomorrow",
      "label": "Tomorrow — all day",
      "follow_filters": false,
      "x": 16,
      "y": 16,
      "w": 8,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Next 7 Days",
      "label": "Next 7 days — rolling",
      "follow_filters": false,
      "x": 24,
      "y": 16,
      "w": 8,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Next 30 Days",
      "label": "Next 30 days — rolling",
      "follow_filters": false,
      "x": 32,
      "y": 16,
      "w": 8,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — All Upcoming",
      "label": "All upcoming (no end date)",
      "follow_filters": false,
      "x": 40,
