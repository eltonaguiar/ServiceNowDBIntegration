{
  "_comment": "Toronto Events dashboard v4: adds the Geomap. follow_filters=False on absolute windows (Today/Tomorrow/7d/30d, the two feeds); the map, the matching list and the charts follow filters.",
  "name": "Toronto Events",
  "grid": 48,
  "table": "u_toronto_event",
  "description": "Live view of Toronto events, with a map of where they concentrate.",
  "widgets": [
    {
      "kind": "filter",
      "label": "Category",
      "field": "u_primary_category",
      "filter_kind": "multiselect",
      "field_type": "string",
      "x": 0,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "filter",
      "label": "When",
      "field": "u_start",
      "filter_kind": "date",
      "x": 16,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "filter",
      "label": "Source",
      "field": "u_source",
      "filter_kind": "multiselect",
      "field_type": "string",
      "x": 32,
      "y": 0,
      "w": 16,
      "h": 4
    },
    {
      "kind": "heading",
      "label": "Toronto events at a glance",
      "level": "1",
      "x": 0,
      "y": 4,
      "w": 48,
      "h": 2
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Today",
      "label": "Today",
      "follow_filters": false,
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Tomorrow",
      "label": "Tomorrow",
      "follow_filters": false,
      "x": 12,
      "y": 6,
      "w": 12,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Next 7 Days",
      "label": "Next 7 days",
      "follow_filters": false,
      "x": 24,
      "y": 6,
      "w": 12,
      "h": 9
    },
    {
      "kind": "chart",
      "report": "Toronto Events — Next 30 Days",
      "label": "Next 30 days",
      "follow_filters": false,
      "x": 36,
      "y": 6,
      "w": 12,
      "h": 9
    },
    {
      "kind": "heading",
      "label": "Events in the period you selected",
      "level": "2",
      "x": 0,
      "y": 15,
      "w": 48,
      "h": 2
    },
    {
      "kind": "list",
      "label": "Matching the Category / When / Source filters",
      "query": "u_startISNOTEMPTY^ORDERBYu_start",
      "columns": [
        "u_start",
        "u_title",
        "u_location",
        "u_primary_category",
        "u_is_free"
      ],
      "follow_filters": true,
      "x": 0,
      "y": 17,
      "w": 48,
      "h": 14
    },
    {
      "kind": "heading",
      "label": "Happening today",
      "level": "2",
      "x": 0,
      "y": 31,
      "w": 24,
      "h": 2
    },
    {
      "kind": "heading",
      "label": "Happening in the next 3 days",
      "level": "2",
      "x": 24,
      "y": 31,
      "w": 24,
      "h": 2
    },
    {
      "kind": "list",
      "label": "Today's events",
      "query": "u_start>=javascript:gs.beginningOfToday()^u_start<=javascript:gs.endOfToday()^ORDERBYu_start",
      "columns": [
        "u_start",
        "u_title",
        "u_location",
        "u_primary_category",
        "u_is_free"
      ],
      "follow_filters": false,
      "x": 0,
      "y": 33,
      "w": 24,
      "h": 18
    },
    {
      "kind": "list",
      "label": "Coming up",
      "query": "u_start>javascript:gs.endOfToday()^u_start<=javascript:gs.daysAgoStart(-3)^ORDERBYu_start",
      "columns": [
        "u_start",
        "u_title",
        "u_location",
        "u_primary_category",
        "u_is_free"
      ],
      "follow_filters": false,
      "x": 24,
      "y": 33,
      "w": 24,
      "h": 18
    },
    {
      "kind": "heading",
      "label": "Where events are happening",
      "level": "2",
      "x": 0,
      "y": 51,
      "w": 48,
      "h": 2
    },
    {
      "kind": "geomap",
      "label": "Event concentration by venue",
      "query": "u_location_refISNOTEMPTY",
