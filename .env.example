# Copy to `.env` and fill in. `.env` is gitignored.
#
# Use a DEDICATED integration user, not your admin account, once you are past
# the learning stage. Minimum roles needed for the scripts here:
#     admin           -> create tables / columns (Table API)
#     personalize_dictionary + import_admin  -> narrower alternative, see README
#
# ACL creation is NOT possible over REST (see README "ACLs"), so no role
# setting here will help with that.

SN_INSTANCE=yourinstance.service-now.com
SN_USER=integration.user
SN_PASS=change-me

# Optional: leave blank to default to https://<SN_INSTANCE>/api/now/table
# SN_BASE_URL=
